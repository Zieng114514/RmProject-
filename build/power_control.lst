 152:modules/motor/power_control.c ****     // 解析数据并对电流和速度进行滤波,电机的反馈报文具体格式见电机说�
 153:modules/motor/power_control.c ****     measure->last_ecd = measure->ecd;
 154:modules/motor/power_control.c ****     measure->ecd = ((uint16_t)rxbuff[0]) << 8 | rxbuff[1];
 155:modules/motor/power_control.c ****     measure->angle_single_round = ECD_ANGLE_COEF_DJI * (float)measure->ecd;
