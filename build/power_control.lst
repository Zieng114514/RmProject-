 144:modules/motor/power_control.c ****     // _instance指针指向的id是对应电机instance的地址,通过强制转换为电机instan
 145:modules/motor/power_control.c ****     uint8_t *rxbuff = _instance->rx_buff;
 146:modules/motor/power_control.c ****     DJIMotorInstance *motor = (DJIMotorInstance *)_instance->id;
 147:modules/motor/power_control.c ****     DJI_Motor_Measure_s *measure = &motor->measure; // measure要多次使用,保存指针减小访
