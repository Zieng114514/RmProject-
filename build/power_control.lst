 163:modules/motor/power_control.c ****     if (measure->ecd - measure->last_ecd > 4096)
 164:modules/motor/power_control.c ****         measure->total_round--;
 165:modules/motor/power_control.c ****     else if (measure->ecd - measure->last_ecd < -4096)
 166:modules/motor/power_control.c ****         measure->total_round++;
 167:modules/motor/power_control.c ****     measure->total_angle = measure->total_round * 360 + measure->angle_single_round;
