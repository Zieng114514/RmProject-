 116:application/robot_task.h **** __attribute__((noreturn)) void StartROBOTTASK(void const *argument)
 117:application/robot_task.h **** {
 118:application/robot_task.h ****     static float robot_dt;
 119:application/robot_task.h ****     static float robot_start;
 120:application/robot_task.h ****     LOGINFO("[freeRTOS] ROBOT core Task Start");
 121:application/robot_task.h ****     // 200Hz-500Hz,若有额外的控制任务如平衡步兵可能需要提升至1kHz
 122:application/robot_task.h ****     for (;;)
 123:application/robot_task.h ****     {
 124:application/robot_task.h ****         robot_start = DWT_GetTimeline_ms();
 125:application/robot_task.h ****         RobotTask();
 126:application/robot_task.h ****         robot_dt = DWT_GetTimeline_ms() - robot_start;
 127:application/robot_task.h ****         if (robot_dt > 5)
 128:application/robot_task.h ****             LOGERROR("[freeRTOS] ROBOT core Task is being DELAY! dt = [%f]", &robot_dt);
 129:application/robot_task.h ****         osDelay(5);
 130:application/robot_task.h ****     }
 131:application/robot_task.h **** }
