   1:application/gimbal/gimbal.c **** // 云台模块：负责 yaw/pitch 两轴的初始化与任务控制
   2:application/gimbal/gimbal.c **** #include "gimbal.h"
   3:application/gimbal/gimbal.c **** #include <math.h>
   4:application/gimbal/gimbal.c **** // 机器人参数宏：尺寸、安装偏置、角度单位转换等
   5:application/gimbal/gimbal.c **** #include "robot_def.h"
   6:application/gimbal/gimbal.c **** #include "robot_cmd.h"
   7:application/gimbal/gimbal.c **** // DJI 电机（GM6020/M3508/M2006）统一接口
   8:application/gimbal/gimbal.c **** #include "dji_motor.h"
   9:application/gimbal/gimbal.c **** // 达妙电机（DM4310/DM 系列）接口 - 增强版
  10:application/gimbal/gimbal.c **** #include "dmmotor.h"
  11:application/gimbal/gimbal.c **** // 姿态解算任务接口：提供 IMU 姿态（角度/角速度）数据
  12:application/gimbal/gimbal.c **** #include "ins_task.h"
  13:application/gimbal/gimbal.c **** // 发布订阅消息中心：云台与上层 cmd 模块通信
  14:application/gimbal/gimbal.c **** #include "message_center.h"
  15:application/gimbal/gimbal.c **** #include "sp_vision/sp_vision.h"
  16:application/gimbal/gimbal.c **** // 通用宏/类型
  17:application/gimbal/gimbal.c **** #include "general_def.h"
  18:application/gimbal/gimbal.c **** // BMI088 传感器接口（云台常用 IMU）
  19:application/gimbal/gimbal.c **** #include "bmi088.h"
  20:application/gimbal/gimbal.c **** 
  21:application/gimbal/gimbal.c **** /**
  22:application/gimbal/gimbal.c ****  * @brief DM电机使用说明
  23:application/gimbal/gimbal.c ****  *
  24:application/gimbal/gimbal.c ****  * 本模块使用增强版DM电机接口，支持以下功能：
  25:application/gimbal/gimbal.c ****  * 1. 统一的measure结构体数据访问
  26:application/gimbal/gimbal.c ****  * 2. 完善的电机状态监控
  27:application/gimbal/gimbal.c ****  * 3. 温度保护和错误处理
  28:application/gimbal/gimbal.c ****  * 4. 多种控制模式支持（MIT模式、位置控制等）
  29:application/gimbal/gimbal.c ****  * 5. 完整的位置、速度、电流三环PID控制
  30:application/gimbal/gimbal.c ****  * 6. 支持外部反馈源（如IMU数据）
ARM GAS  /var/folders/kr/_85zhnz53vldd5tqwnc25svm0000gn/T//ccO8iohc.s 			page 2


  31:application/gimbal/gimbal.c ****  *
  32:application/gimbal/gimbal.c ****  * 主要API：
  33:application/gimbal/gimbal.c ****  * - DMMotorGetMeasure(): 获取电机测量数据结构指针
  34:application/gimbal/gimbal.c ****  * - DMMotorGetStatus(): 获取电机状态
  35:application/gimbal/gimbal.c ****  * - DMMotorSetPosition(): 设置目标位置
  36:application/gimbal/gimbal.c ****  * - DMMotorSetCurrent(): 设置目标电流
  37:application/gimbal/gimbal.c ****  * - DMMotorSetRef(): 设置PID参考值
  38:application/gimbal/gimbal.c ****  * - DMMotorEnable/Disable/Stop(): 电机控制
  39:application/gimbal/gimbal.c ****  * - DMMotorOuterLoop(): 设置外环控制类型
  40:application/gimbal/gimbal.c ****  *
  41:application/gimbal/gimbal.c ****  * PID控制说明：
  42:application/gimbal/gimbal.c ****  * - 支持位置环、速度环的串级控制（已去掉电流环）
  43:application/gimbal/gimbal.c ****  * - 支持电机自身反馈和外部反馈（如IMU）
  44:application/gimbal/gimbal.c ****  * - 支持正反转和反馈反向设置
  45:application/gimbal/gimbal.c ****  * - 自动进行输出限幅和死区处理
  46:application/gimbal/gimbal.c ****  */
  47:application/gimbal/gimbal.c **** 
