 171:modules/motor/DJImotor/dji_motor.c **** /**
 172:modules/motor/DJImotor/dji_motor.c ****  * @todo  是否可以简化多圈角度的计算？
 173:modules/motor/DJImotor/dji_motor.c ****  * @brief 根据返回的can_instance对反馈报文进行解析
 174:modules/motor/DJImotor/dji_motor.c ****  *
 175:modules/motor/DJImotor/dji_motor.c ****  * @param _instance 收到数据的instance,通过遍历与所有电机进行对比以选择正确�
 176:modules/motor/DJImotor/dji_motor.c ****  */
 177:modules/motor/DJImotor/dji_motor.c **** static void DecodeDJIMotor(CANInstance *_instance)
 178:modules/motor/DJImotor/dji_motor.c **** {
 179:modules/motor/DJImotor/dji_motor.c ****     // 这里对can instance的id进行了强制转换,从而获得电机的instance实例地址
 180:modules/motor/DJImotor/dji_motor.c ****     // _instance指针指向的id是对应电机instance的地址,通过强制转换为电机instan
 181:modules/motor/DJImotor/dji_motor.c ****     uint8_t *rxbuff = _instance->rx_buff;
 182:modules/motor/DJImotor/dji_motor.c ****     DJIMotorInstance *motor = (DJIMotorInstance *)_instance->id;
 183:modules/motor/DJImotor/dji_motor.c ****     DJI_Motor_Measure_s *measure = &motor->measure; // measure要多次使用,保存指针减小访
 184:modules/motor/DJImotor/dji_motor.c **** 
 185:modules/motor/DJImotor/dji_motor.c ****     DaemonReload(motor->daemon);
 186:modules/motor/DJImotor/dji_motor.c ****     motor->dt = DWT_GetDeltaT(&motor->feed_cnt);
 187:modules/motor/DJImotor/dji_motor.c **** 
 188:modules/motor/DJImotor/dji_motor.c ****     // 更新频率监测变量 (用于Live Watch调试)
 189:modules/motor/DJImotor/dji_motor.c ****     if (motor->motor_idx < DJI_MOTOR_CNT) {
 190:modules/motor/DJImotor/dji_motor.c ****         motor_feedback_dt[motor->motor_idx] = motor->dt * 1000.0f;  // 转换为ms
 191:modules/motor/DJImotor/dji_motor.c ****         motor_feedback_freq[motor->motor_idx] = (motor->dt > 0.00001f) ? (1.0f / motor->dt) : 0.0f;
 192:modules/motor/DJImotor/dji_motor.c ****     }
 193:modules/motor/DJImotor/dji_motor.c **** 
 194:modules/motor/DJImotor/dji_motor.c ****     // 解析数据并对电流和速度进行滤波,电机的反馈报文具体格式见电机说�
 195:modules/motor/DJImotor/dji_motor.c ****     measure->last_ecd = measure->ecd;
 196:modules/motor/DJImotor/dji_motor.c ****     measure->ecd = ((uint16_t)rxbuff[0]) << 8 | rxbuff[1];
 197:modules/motor/DJImotor/dji_motor.c ****     measure->angle_single_round = ECD_ANGLE_COEF_DJI * (float)measure->ecd;
 198:modules/motor/DJImotor/dji_motor.c ****     measure->speed_aps = (1.0f - SPEED_SMOOTH_COEF) * measure->speed_aps +
 199:modules/motor/DJImotor/dji_motor.c ****                          RPM_2_ANGLE_PER_SEC * SPEED_SMOOTH_COEF * (float)((int16_t)(rxbuff[2] << 8
 200:modules/motor/DJImotor/dji_motor.c ****     measure->real_current = (1.0f - CURRENT_SMOOTH_COEF) * measure->real_current +
 201:modules/motor/DJImotor/dji_motor.c ****                             CURRENT_SMOOTH_COEF * (float)((int16_t)(rxbuff[4] << 8 | rxbuff[5]));
 202:modules/motor/DJImotor/dji_motor.c ****     measure->temperature = rxbuff[6];
 203:modules/motor/DJImotor/dji_motor.c **** 
 204:modules/motor/DJImotor/dji_motor.c ****     // 多圈角度计算,前提是假设两次采样间电机转过的角度小于180°,自己画�
 205:modules/motor/DJImotor/dji_motor.c ****     if (measure->ecd - measure->last_ecd > 4096)
 206:modules/motor/DJImotor/dji_motor.c ****         measure->total_round--;
 207:modules/motor/DJImotor/dji_motor.c ****     else if (measure->ecd - measure->last_ecd < -4096)
 208:modules/motor/DJImotor/dji_motor.c ****         measure->total_round++;
 209:modules/motor/DJImotor/dji_motor.c ****     measure->total_angle = measure->total_round * 360 + measure->angle_single_round;
 210:modules/motor/DJImotor/dji_motor.c **** }
