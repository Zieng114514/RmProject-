 152:application/cmd/robot_cmd.c **** /**
 153:application/cmd/robot_cmd.c ****  * @brief 根据gimbal app传回的当前电机角度计算和零位的误差
 154:application/cmd/robot_cmd.c ****  *        单圈绝对角度的范围是0~360,说明文档中有图示
 155:application/cmd/robot_cmd.c ****  *
 156:application/cmd/robot_cmd.c ****  */
 157:application/cmd/robot_cmd.c **** static void CalcOffsetAngle()
 158:application/cmd/robot_cmd.c **** {
 159:application/cmd/robot_cmd.c ****     // 别名angle提高可读性,不然太长了不好看,虽然基本不会动这个函数
 160:application/cmd/robot_cmd.c ****     static float angle;
 161:application/cmd/robot_cmd.c ****     angle = gimbal_fetch_data.yaw_motor_single_round_angle; // 从云台获取的当前yaw电机单
 162:application/cmd/robot_cmd.c **** #if YAW_ECD_GREATER_THAN_4096                               // 如果大于180度
 163:application/cmd/robot_cmd.c ****     if (angle > YAW_ALIGN_ANGLE && angle <= 180.0f + YAW_ALIGN_ANGLE)
 164:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 165:application/cmd/robot_cmd.c ****     else if (angle > 180.0f + YAW_ALIGN_ANGLE)
 166:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE - 360.0f;
 167:application/cmd/robot_cmd.c ****     else
 168:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 169:application/cmd/robot_cmd.c **** #else // 小于180度
 170:application/cmd/robot_cmd.c ****     if (angle > YAW_ALIGN_ANGLE)
 171:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 172:application/cmd/robot_cmd.c ****     else if (angle <= YAW_ALIGN_ANGLE && angle >= YAW_ALIGN_ANGLE - 180.0f)
 173:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 174:application/cmd/robot_cmd.c ****     else
 175:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE + 360.0f;
 176:application/cmd/robot_cmd.c **** #endif
 177:application/cmd/robot_cmd.c **** }
