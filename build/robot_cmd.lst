 155:application/cmd/robot_cmd.c **** /**
 156:application/cmd/robot_cmd.c ****  * @brief 根据gimbal app传回的当前电机角度计算和零位的误差
 157:application/cmd/robot_cmd.c ****  *        单圈绝对角度的范围是0~360,说明文档中有图示
 158:application/cmd/robot_cmd.c ****  *
 159:application/cmd/robot_cmd.c ****  */
 160:application/cmd/robot_cmd.c **** static void CalcOffsetAngle()
 161:application/cmd/robot_cmd.c **** {
 162:application/cmd/robot_cmd.c ****     // 别名angle提高可读性,不然太长了不好看,虽然基本不会动这个函数
 163:application/cmd/robot_cmd.c ****     static float angle;
 164:application/cmd/robot_cmd.c ****     angle = gimbal_fetch_data.yaw_motor_single_round_angle; // 从云台获取的当前yaw电机单
 165:application/cmd/robot_cmd.c **** #if YAW_ECD_GREATER_THAN_4096                               // 如果大于180度
 166:application/cmd/robot_cmd.c ****     if (angle > YAW_ALIGN_ANGLE && angle <= 180.0f + YAW_ALIGN_ANGLE)
 167:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 168:application/cmd/robot_cmd.c ****     else if (angle > 180.0f + YAW_ALIGN_ANGLE)
 169:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE - 360.0f;
 170:application/cmd/robot_cmd.c ****     else
 171:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 172:application/cmd/robot_cmd.c **** #else // 小于180度
 173:application/cmd/robot_cmd.c ****     if (angle > YAW_ALIGN_ANGLE)
 174:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 175:application/cmd/robot_cmd.c ****     else if (angle <= YAW_ALIGN_ANGLE && angle >= YAW_ALIGN_ANGLE - 180.0f)
 176:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE;
 177:application/cmd/robot_cmd.c ****     else
 178:application/cmd/robot_cmd.c ****         chassis_cmd_send.offset_angle = angle - YAW_ALIGN_ANGLE + 360.0f;
 179:application/cmd/robot_cmd.c **** #endif
 180:application/cmd/robot_cmd.c **** }
