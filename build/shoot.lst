 220:application/shoot/shoot.c ****         // 三连发
 221:application/shoot/shoot.c ****         case LOAD_3_BULLET:
 222:application/shoot/shoot.c ****             DJIMotorOuterLoop(loader, SPEED_LOOP);
 223:application/shoot/shoot.c ****             DJIMotorSetRef(loader, 40);
 224:application/shoot/shoot.c ****             break;
 225:application/shoot/shoot.c **** 
 226:application/shoot/shoot.c ****         // 连发模式
 227:application/shoot/shoot.c ****         case LOAD_BURSTFIRE:
 228:application/shoot/shoot.c ****             DJIMotorOuterLoop(loader, SPEED_LOOP);
 229:application/shoot/shoot.c ****             // 正常发射用负数速度（假设负数是正转发射方向）
 230:application/shoot/shoot.c ****             DJIMotorSetRef(loader,11000);
 231:application/shoot/shoot.c ****             break;
 232:application/shoot/shoot.c **** 
 233:application/shoot/shoot.c ****         // 反转模式（卡弹处理）
 234:application/shoot/shoot.c ****         case LOAD_REVERSE:
 235:application/shoot/shoot.c ****             DJIMotorOuterLoop(loader, SPEED_LOOP);
 236:application/shoot/shoot.c ****             // 反转用正数速度（与正常发射方向相反）
 237:application/shoot/shoot.c ****             DJIMotorSetRef(loader, 6000);
 238:application/shoot/shoot.c ****             break;
 239:application/shoot/shoot.c **** 
 240:application/shoot/shoot.c ****         default:
 241:application/shoot/shoot.c ****             break;
 242:application/shoot/shoot.c ****     }
